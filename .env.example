# ==========================================
# DocuMind Configuration
# ==========================================

# Google Gemini API Key (Dapatkan gratis di https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Generation Model (Rekomendasi: gemini-2.5-flash atau gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Embeddings Model (Pilihan: text-embedding-004 atau default local Chroma)
EMBEDDING_MODEL=text-embedding-004

# Document Chunking Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval Settings
TOP_K_RESULTS=4

# Server Configuration
PORT=8501
